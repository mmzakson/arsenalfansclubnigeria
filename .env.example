# ---------- App ----------
# Public URL of the deployed site (no trailing slash). Used for payment callbacks and the QR code on the card.
APP_URL=http://localhost:3000
# Any long random string (16+ chars). Signs card links and security stamps. Generate: openssl rand -hex 32
CARD_SIGNING_SECRET=
# Registration fee in naira. The amount charged always comes from here, never from the browser.
REGISTRATION_FEE_NGN=5000
# How long a membership lasts from the payment date.
MEMBERSHIP_VALIDITY_MONTHS=12

# ---------- Firebase (Admin SDK, server only) ----------
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n sequences exactly as in the downloaded JSON. In a .env file keep the quotes;
# in a host dashboard (e.g. HCode) paste the value WITHOUT quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Payments ----------
# Order of preference. The first working gateway is used; if it errors, the next one is tried automatically.
# (You can override this live without redeploying: see "Switching gateways" in the README.)
PAYMENT_GATEWAYS=squad,paystack

# Squad: dashboard > Profile > API & Webhooks. Sandbox secret keys start with sandbox_sk_
SQUAD_SECRET_KEY=
# Optional override; by default sandbox_ keys use sandbox-api-d.squadco.com and live keys use api-d.squadco.com
# SQUAD_BASE_URL=

# Paystack (standby)
PAYSTACK_SECRET_KEY=
